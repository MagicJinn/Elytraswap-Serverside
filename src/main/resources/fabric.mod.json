{
	"schemaVersion": 1,
	"id": "elytraswap-serverside",
	"version": "${version}",
	"name": "Elytraswap Serverside",
	"description": "Server-side elytra swapping so players can swap between elytra and chestplate without a client mod.",
	"authors": [
		"MagicJinn"
	],
	"contact": {
		"homepage": "https://github.com/MagicJinn/Elytraswap-Serverside",
		"issues": "https://github.com/MagicJinn/Elytraswap-Serverside/issues"
	},
	"license": "MIT",
	"icon": "assets/elytraswap-serverside/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"magicjinn.elytraswap.serverside.ElytraswapServerside"
		],
		"client": [
			"magicjinn.elytraswap.serverside.client.ElytraswapServersideClient"
		]
	},
	"mixins": [
		"elytraswap-serverside.mixins.json",
		{
			"config": "elytraswap-serverside.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/bQvtauxXWp",
				"modmenu.source": "https://github.com/MagicJinn/Elytraswap-Serverside"
			}
		}
	}
}
